# ---------- App ----------
APP_NAME="ExpenseOps Agent"
DATABASE_URL="sqlite:///./expenseops.db"
ENVIRONMENT="local"
FRONTEND_ORIGIN="http://localhost:5174"
APP_ENV="local"
ALLOW_UNVERIFIED_PLAID_WEBHOOKS_FOR_LOCAL_TEST="false"
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY="paste-a-generated-fernet-key-here"
# Required in production. Basic auth is convenient for a private personal deployment.
DASHBOARD_USERNAME=""
DASHBOARD_PASSWORD=""
# Optional alternative for API clients; leave blank when using username/password.
DASHBOARD_API_TOKEN=""

# In local dev, keep this false unless you implement/confirm JWT verification.
PLAID_VERIFY_WEBHOOKS=false
ALLOW_POSTING_PENDING_TRANSACTIONS=false

# ---------- Plaid ----------
# Create a Plaid app and use sandbox first.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"   # sandbox | development | production
ENABLE_EXPENSEOPS_SANDBOX_LAB="true"
PLAID_VERIFY_WEBHOOKS_IN_SANDBOX="true"
PLAID_WEBHOOK_URL="https://your-ngrok-url.ngrok-free.app/plaid/webhook"
PLAID_COUNTRY_CODES="US"
PLAID_PRODUCTS="transactions"
PLAID_DAYS_REQUESTED=90

# ---------- Splitwise ----------
SPLITWISE_BASE_URL="https://secure.splitwise.com/api/v3.0"

# Paste the API key generated from your Splitwise app.
SPLITWISE_API_KEY=""

# Leave bearer/OAuth fields blank when using SPLITWISE_API_KEY.
SPLITWISE_ACCESS_TOKEN=""
SPLITWISE_AUTH_SCHEME="Bearer"

# Optional OAuth 1.0 fallback.
SPLITWISE_CONSUMER_KEY=""
SPLITWISE_CONSUMER_SECRET=""
SPLITWISE_OAUTH_CALLBACK_URL="http://localhost:8010/splitwise/oauth/callback"
SPLITWISE_OAUTH_TOKEN=""
SPLITWISE_OAUTH_TOKEN_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ALLOWED_USER_ID=""

# Optional notification bot. Console logging works without these.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- OpenAI ----------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# ---------- Household Ops ----------
# Optional starting address used in generated Google Maps directions links.
# Keep personal addresses in environment configuration, never source control.
HOUSEHOLD_BASE_LOCATION=""
# Default snooze used by "Still have it" and "Skip once".
HOUSEHOLD_SNOOZE_DAYS=7
# "fallback" makes no time/distance claims. Use "google_maps" only with a restricted key.
HOUSEHOLD_ROUTING_PROVIDER="fallback"
HOUSEHOLD_PLACE_SEARCH_PROVIDER="fallback"
GOOGLE_MAPS_API_KEY=""
# Maximum measured detour considered useful for normal errands / probably-due items.
HOUSEHOLD_MAX_INCREMENTAL_MINUTES=10
HOUSEHOLD_PROBABLY_DUE_INCREMENTAL_MINUTES=5
# Bounds live API work when comparing physical-location combinations.
HOUSEHOLD_PLACE_CANDIDATES_PER_ERRAND=3
HOUSEHOLD_MAX_PLACE_COMBINATIONS=27
# Prefer a remembered place when its complete route is within this many minutes of the best.
HOUSEHOLD_PREFERRED_PLACE_BIAS_MINUTES=3
# Reuse identical Places/Geocoding/Routes results for 15 minutes.
HOUSEHOLD_PROVIDER_CACHE_TTL_SECONDS=900
