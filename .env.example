# ---------- App ----------
APP_NAME="ExpenseOps Agent"
DATABASE_URL="sqlite:///./expenseops.db"
ENVIRONMENT="local"
FRONTEND_ORIGIN="http://localhost:5174"
APP_ENV="local"
ALLOW_UNVERIFIED_PLAID_WEBHOOKS_FOR_LOCAL_TEST="false"
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY="paste-a-generated-fernet-key-here"
# Local development fallback only. Production OIDC ignores these static credentials.
DASHBOARD_USERNAME=""
DASHBOARD_PASSWORD=""
# Optional local API-client fallback; never use as production user authentication.
DASHBOARD_API_TOKEN=""
# Used only to make Telegram's "Edit matches" button open this private dashboard.
APP_PUBLIC_URL=""

# ---------- Authentication ----------
# Local keeps the existing private-development fallback. Production must use oidc.
AUTH_MODE="local" # local | oidc
OIDC_ISSUER=""
OIDC_AUDIENCE=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:8000/auth/callback"
OIDC_SCOPES="openid profile email"
OIDC_ALGORITHMS="RS256"
# Optional one-time claim of migrated single-user data by this verified OIDC email.
OIDC_BOOTSTRAP_EMAIL=""
AUTH_SESSION_COOKIE_NAME="expenseops_session"
AUTH_SESSION_HOURS=168
# Comma-separated verified emails allowed to read the protected onboarding funnel.
ADMIN_USER_EMAILS=""
# Single-process backend. Use one web replica until the shared Phase 1C backend is added.
RATE_LIMIT_BACKEND="memory"
# Phase 1C reservation: application authorization remains mandatory.
ENABLE_POSTGRES_RLS=false

# In local dev, keep this false unless you implement/confirm JWT verification.
PLAID_VERIFY_WEBHOOKS=false
ALLOW_POSTING_PENDING_TRANSACTIONS=false

# ---------- Plaid ----------
# Create a Plaid app and use sandbox first.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"   # sandbox | development | production
ENABLE_EXPENSEOPS_SANDBOX_LAB="true"
PLAID_VERIFY_WEBHOOKS_IN_SANDBOX="true"
PLAID_WEBHOOK_URL="https://your-ngrok-url.ngrok-free.app/plaid/webhook"
PLAID_COUNTRY_CODES="US"
PLAID_PRODUCTS="transactions"
PLAID_DAYS_REQUESTED=90

# ---------- Splitwise ----------
SPLITWISE_BASE_URL="https://secure.splitwise.com/api/v3.0"

# Paste the API key generated from your Splitwise app.
SPLITWISE_API_KEY=""

# Leave bearer/OAuth fields blank when using SPLITWISE_API_KEY.
SPLITWISE_ACCESS_TOKEN=""
SPLITWISE_AUTH_SCHEME="Bearer"

# Optional OAuth 1.0 fallback.
SPLITWISE_CONSUMER_KEY=""
SPLITWISE_CONSUMER_SECRET=""
SPLITWISE_OAUTH_CALLBACK_URL="http://localhost:8000/splitwise/oauth/callback"
SPLITWISE_OAUTH_TOKEN=""
SPLITWISE_OAUTH_TOKEN_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ALLOWED_USER_ID=""

# Optional notification bot. Console logging works without these.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- OpenAI ----------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# ---------- Replenishment learning ----------
# "fallback" disables automatic receipt parsing; "openai" enables image/PDF/email parsing.
RECEIPT_PARSER_PROVIDER="fallback"
RECEIPT_PARSER_MODEL="gpt-4.1-mini"
RECEIPT_MAX_ATTACHMENT_BYTES=10000000
RECEIPT_AUTO_MATCH_CONFIDENCE=0.90
RECEIPT_POSSIBLE_MATCH_CONFIDENCE=0.65

# Gmail is opt-in and uses the gmail.readonly OAuth scope. The query remains narrow.
GMAIL_RECEIPT_SYNC_ENABLED=false
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_ID="me"
GMAIL_RECEIPT_QUERY="newer_than:30d (subject:(receipt OR order OR purchase) OR from:(walmart.com target.com costco.com instacart.com amazon.com))"

# ---------- Promotion Intelligence ----------
# Reuses the Gmail OAuth credentials above with gmail.readonly access.
PROMOTIONS_ENABLED=false
PROMOTIONS_INITIAL_LOOKBACK_DAYS=30
PROMOTIONS_MAX_MESSAGES_PER_SYNC=100
PROMOTIONS_LLM_FALLBACK_ENABLED=true
PROMOTIONS_MAX_LLM_BODY_CHARS=12000
PROMOTIONS_MIN_SCORE=50
PROMOTIONS_DIGEST_ENABLED=false
PROMOTIONS_DIGEST_CADENCE="weekly"
PROMOTIONS_DIGEST_MAX_DEALS=8
PROMOTIONS_DIGEST_TIMEZONE="UTC"
PROMOTIONS_DIGEST_LOCAL_HOUR=17
PROMOTIONS_SYNC_SCHEDULE="0 */6 * * *"
GMAIL_PUSH_ENABLED=false
GMAIL_PUBSUB_TOPIC=""

# Global lightweight model guardrails and the documented weekly cron schedule.
REPLENISHMENT_ML_MIN_ROWS=30
REPLENISHMENT_ML_MIN_VALIDATION_ROWS=8
REPLENISHMENT_WALK_FORWARD_MIN_ROWS=60
REPLENISHMENT_MODEL_MIN_MAE_IMPROVEMENT_PCT=10
REPLENISHMENT_MODEL_MIN_MAE_IMPROVEMENT_DAYS=1.0
REPLENISHMENT_MAX_FEEDBACK_CADENCE_ADJUSTMENT_PCT=25
REPLENISHMENT_WEEKLY_SCHEDULE="0 9 * * 0"

# ---------- Household Ops ----------
# Optional starting address used in generated Google Maps directions links.
# Keep personal addresses in environment configuration, never source control.
HOUSEHOLD_BASE_LOCATION=""
# Default snooze used by "Still have it" and "Skip once".
HOUSEHOLD_SNOOZE_DAYS=7
# "fallback" makes no time/distance claims. Use "google_maps" only with a restricted key.
HOUSEHOLD_ROUTING_PROVIDER="fallback"
HOUSEHOLD_PLACE_SEARCH_PROVIDER="fallback"
GOOGLE_MAPS_API_KEY=""
# Maximum measured detour considered useful for normal errands / probably-due items.
HOUSEHOLD_MAX_INCREMENTAL_MINUTES=10
HOUSEHOLD_PROBABLY_DUE_INCREMENTAL_MINUTES=5
# Bounds live API work when comparing physical-location combinations.
HOUSEHOLD_PLACE_CANDIDATES_PER_ERRAND=3
HOUSEHOLD_MAX_PLACE_COMBINATIONS=27
# Prefer a remembered place when its complete route is within this many minutes of the best.
HOUSEHOLD_PREFERRED_PLACE_BIAS_MINUTES=3
# Reuse identical Places/Geocoding/Routes results for 15 minutes.
HOUSEHOLD_PROVIDER_CACHE_TTL_SECONDS=900
